PORT=4000

# Shared secret your own order-confirmation flow must send as the
# x-subeazy-secret header when POSTing to /api/orders/event.
ORDER_EVENT_SECRET=change-me

# Shared secret for POST /api/reviews/:id/approve.
REVIEW_ADMIN_SECRET=change-me

# Meta Conversions API (optional — leave blank to disable server-side relay).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
